# Токен бота (от @BotFather)
# Получить: https://t.me/BotFather → /newbot
BOT_TOKEN=your_bot_token_here

# ID канала (обязательно для проверки подписки)
# Узнать: добавить @getidsbot в канал
CHANNEL_ID=your_channel_id_here

# Ссылка-приглашение в канал
CHANNEL_INVITE_LINK=https://t.me/your_channel_invite_link

# Ссылки на альбомы по дням на Яндекс.Диске (для просмотра участниками)
# Папки должны называться: "Вейновские чтения. 9 февраля. День 1" и т.д.
YANDEX_DAY1_LINK=https://disk.yandex.ru/ВАША_ССЫЛКА_ДЕНЬ1
YANDEX_DAY2_LINK=https://disk.yandex.ru/ВАША_ССЫЛКА_ДЕНЬ2
YANDEX_DAY3_LINK=https://disk.yandex.ru/ВАША_ССЫЛКА_ДЕНЬ3

# Ссылки для фотографа (загрузка файлов в папки)
# Создайте отдельные ссылки с правами на запись для каждой папки
YANDEX_DAY1_UPLOAD_LINK=https://disk.yandex.ru/ССЫЛКА_ДЛЯ_ЗАГРУЗКИ_ДЕНЬ1
YANDEX_DAY2_UPLOAD_LINK=https://disk.yandex.ru/ССЫЛКА_ДЛЯ_ЗАГРУЗКИ_ДЕНЬ2
YANDEX_DAY3_UPLOAD_LINK=https://disk.yandex.ru/ССЫЛКА_ДЛЯ_ЗАГРУЗКИ_ДЕНЬ3

# Картинки для бота: путь к файлу или URL (лучше латиница в именах файлов)
# 01 - при /start; 02 - подтвердить подписку (при /start + при проверке); 03 - выбор специальности;
# 04 - Фото-Центр, выбор дня; 05 - расписание конгресса (с кнопкой Программа)
# WELCOME_IMAGE=images/01_welcome.jpg
# IMAGE_SUBSCRIBE=images/02_subscribe.jpg
# IMAGE_SPECIALTY=images/03_specialty.jpg
# IMAGE_PHOTO_CENTER=images/04_photo_center.jpg
# IMAGE_PROGRAM=images/05_program.jpg

# Место проведения (пока не используется)
# PLACE=

# Ссылка на расписание конгресса — кнопка «Расписание» в меню бота
# По умолчанию: http://185.198.152.146:8080/
# PROGRAM_SCHEDULE_URL=http://185.198.152.146:8080/

# ID администраторов через запятую (для /notify_day1, /notify_day2, /notify_day3, /notify_ready)
# ADMIN_IDS=123456789,987654321

# Путь к файлу SQLite-базы (по умолчанию bot.db)
# DB_PATH=bot.db

# Google Sheets — способ 1: Web App (БЕЗ Google Cloud Console)
# Скопируйте URL после развертывания скрипта из google-sheets-script.js
# SHEETS_WEBAPP_URL=https://script.google.com/macros/s/xxx/exec
# Timezone for timestamp in Google Sheet (default: Europe/Moscow)
# SHEETS_TIMEZONE=Europe/Moscow

# Google Sheets — способ 2: через API (нужен Google Cloud Console)
# GOOGLE_SHEETS_ID=
# GOOGLE_CREDENTIALS=credentials.json
